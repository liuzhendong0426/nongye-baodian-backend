# 种植宝典阿里云服务器环境变量示例
#
# 使用方法：
# 1. 上传到服务器后复制为 backend/.env
# 2. 把下面的占位值替换为真实值
# 3. 不要把真实 .env 发给别人，也不要提交到公开仓库

PORT=3000

# 移动端访问后端时使用的令牌。
# 必须和 Flutter 构建时 --dart-define=BACKEND_APP_TOKEN 的值一致。
SERVER_TOKEN=YOUR_LONG_RANDOM_SERVER_TOKEN

# AI 服务密钥，至少配置一个可用模型。
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_KEY
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_KEY
ZHIPU_API_KEY=YOUR_ZHIPU_KEY

# 和风天气密钥。
QWEATHER_API_KEY=YOUR_QWEATHER_KEY
